            <span class="s1">'time'</span><span class="p">:</span> <span class="n">ds</span><span class="o">.</span><span class="n">time</span><span class="p">,</span>
            <span class="s1">'lev'</span><span class="p">:</span> <span class="n">p_target</span><span class="p">,</span>
            <span class="s1">'ncol'</span><span class="p">:</span> <span class="n">ds</span><span class="o">.</span><span class="n">ncol</span>
        <span class="p">},</span>
        <span class="n">attrs</span> <span class="o">=</span> <span class="p">{</span><span class="s1">'long_name'</span><span class="p">:</span> <span class="sa">f</span><span class="s1">'</span><span class="si">{</span><span class="n">zvar</span><span class="si">}</span><span class="s1"> on pressure levels'</span><span class="p">,</span> <span class="s1">'units'</span><span class="p">:</span> <span class="s1">'m'</span><span class="p">}</span>
    <span class="p">)</span>
    <span class="n">template</span><span class="o">.</span><span class="n">to_dataset</span><span class="p">(</span><span class="n">name</span> <span class="o">=</span> <span class="n">zvar</span><span class="p">)</span><span class="o">.</span><span class="n">to_zarr</span><span class="p">(</span><span class="n">zarr_path</span><span class="p">,</span> <span class="n">mode</span> <span class="o">=</span> <span class="s1">'w'</span><span class="p">,</span> <span class="n">consolidated</span> <span class="o">=</span> <span class="kc">False</span><span class="p">)</span>

