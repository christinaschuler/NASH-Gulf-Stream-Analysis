    <span class="n">Ncol</span> <span class="o">=</span> <span class="n">ds</span><span class="o">.</span><span class="n">sizes</span><span class="p">[</span><span class="s1">'ncol'</span><span class="p">]</span>
    <span class="n">Nlev_out</span> <span class="o">=</span> <span class="nb">len</span><span class="p">(</span><span class="n">p_target</span><span class="p">)</span>

