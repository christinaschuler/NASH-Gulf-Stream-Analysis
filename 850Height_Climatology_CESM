            <span class="n">c1</span> <span class="o">=</span> <span class="nb">min</span><span class="p">(</span><span class="n">c0</span> <span class="o">+</span> <span class="n">ncol_chunk</span><span class="p">,</span> <span class="n">Ncol</span><span class="p">)</span>

