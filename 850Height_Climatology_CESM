<div class="highlight hl-ipython3"><pre><span></span><span class="kn">from</span><span class="w"> </span><span class="nn">scipy.ndimage</span><span class="w"> </span><span class="kn">import</span> <span class="n">gaussian_filter</span>

<span class="c1">#NaN-aware smoothing</span>
<span class="k">def</span><span class="w"> </span><span class="nf">smooth_nanaware</span><span class="p">(</span><span class="n">arr</span><span class="p">,</span> <span class="n">sigma</span> <span class="o">=</span> <span class="mi">4</span><span class="p">):</span>
    <span class="n">mask</span> <span class="o">=</span> <span class="o">~</span><span class="n">np</span><span class="o">.</span><span class="n">isnan</span><span class="p">(</span><span class="n">arr</span><span class="p">)</span>
    <span class="n">filled</span> <span class="o">=</span> <span class="n">np</span><span class="o">.</span><span class="n">where</span><span class="p">(</span><span class="n">mask</span><span class="p">,</span> <span class="n">arr</span><span class="p">,</span> <span class="mf">0.0</span><span class="p">)</span>
    <span class="n">smooth</span> <span class="o">=</span> <span class="n">gaussian_filter</span><span class="p">(</span><span class="n">filled</span><span class="p">,</span> <span class="n">sigma</span> <span class="o">=</span> <span class="n">sigma</span><span class="p">)</span>
    <span class="n">weights</span> <span class="o">=</span> <span class="n">gaussian_filter</span><span class="p">(</span><span class="n">mask</span><span class="o">.</span><span class="n">astype</span><span class="p">(</span><span class="nb">float</span><span class="p">),</span> <span class="n">sigma</span> <span class="o">=</span> <span class="n">sigma</span><span class="p">)</span>
    <span class="k">with</span> <span class="n">np</span><span class="o">.</span><span class="n">errstate</span><span class="p">(</span><span class="n">invalid</span> <span class="o">=</span> <span class="s2">"ignore"</span><span class="p">):</span>
        <span class="n">out</span> <span class="o">=</span> <span class="n">smooth</span> <span class="o">/</span> <span class="n">weights</span>
    <span class="n">out</span><span class="p">[</span><span class="o">~</span><span class="n">mask</span><span class="p">]</span> <span class="o">=</span> <span class="n">np</span><span class="o">.</span><span class="n">nan</span>
    <span class="k">return</span> <span class="n">out</span>

<span class="c1">#Chunked regridding</span>
<span class="k">def</span><span class="w"> </span><span class="nf">regrid_monthly_climatology_region</span><span class="p">(</span>
    <span class="n">zarr_path</span><span class="p">,</span>
    <span class="n">ds_native</span><span class="p">,</span>
    <span class="n">lat_bounds</span> <span class="o">=</span> <span class="p">(</span><span class="mi">10</span><span class="p">,</span> <span class="mi">60</span><span class="p">),</span>
    <span class="n">lon_bounds</span> <span class="o">=</span> <span class="p">(</span><span class="mi">260</span><span class="p">,</span> <span class="mi">350</span><span class="p">),</span>
    <span class="n">p_level</span> <span class="o">=</span> <span class="mi">85000</span><span class="p">,</span>
    <span class="n">months</span> <span class="o">=</span> <span class="p">[</span><span class="mi">6</span><span class="p">,</span> <span class="mi">7</span><span class="p">,</span> <span class="mi">8</span><span class="p">,</span> <span class="mi">9</span><span class="p">,</span> <span class="mi">10</span><span class="p">,</span> <span class="mi">11</span><span class="p">],</span>
    <span class="n">grid_res</span> <span class="o">=</span> <span class="mi">200</span><span class="p">,</span>
    <span class="n">smooth_sigma</span> <span class="o">=</span> <span class="mi">4</span><span class="p">,</span>
    <span class="n">ncol_chunk</span> <span class="o">=</span> <span class="mi">50_000</span>
<span class="p">):</span>
    <span class="n">t0_all</span> <span class="o">=</span> <span class="n">time</span><span class="o">.</span><span class="n">time</span><span class="p">()</span>

    <span class="c1">#Open Zarr lazily</span>
    <span class="n">ds_z3</span> <span class="o">=</span> <span class="n">xr</span><span class="o">.</span><span class="n">open_zarr</span><span class="p">(</span><span class="n">zarr_path</span><span class="p">,</span> <span class="n">consolidated</span> <span class="o">=</span> <span class="kc">False</span><span class="p">)</span>
    <span class="n">z3</span> <span class="o">=</span> <span class="n">ds_z3</span><span class="p">[</span><span class="s1">'Z3'</span><span class="p">]</span><span class="o">.</span><span class="n">sel</span><span class="p">(</span><span class="n">lev</span> <span class="o">=</span> <span class="n">p_level</span><span class="p">,</span> <span class="n">method</span> <span class="o">=</span> <span class="s1">'nearest'</span><span class="p">)</span>
    
    <span class="c1">#Filter months</span>
    <span class="n">z3</span> <span class="o">=</span> <span class="n">z3</span><span class="o">.</span><span class="n">sel</span><span class="p">(</span><span class="n">time</span> <span class="o">=</span> <span class="n">z3</span><span class="o">.</span><span class="n">time</span><span class="o">.</span><span class="n">dt</span><span class="o">.</span><span class="n">month</span><span class="o">.</span><span class="n">isin</span><span class="p">(</span><span class="n">months</span><span class="p">))</span>
    
    <span class="c1">#Subset native grid to region</span>
    <span class="n">lat_all</span> <span class="o">=</span> <span class="n">ds_native</span><span class="p">[</span><span class="s1">'lat'</span><span class="p">]</span><span class="o">.</span><span class="n">isel</span><span class="p">(</span><span class="n">time</span> <span class="o">=</span> <span class="mi">0</span><span class="p">)</span>
    <span class="n">lon_all</span> <span class="o">=</span> <span class="n">ds_native</span><span class="p">[</span><span class="s1">'lon'</span><span class="p">]</span><span class="o">.</span><span class="n">isel</span><span class="p">(</span><span class="n">time</span> <span class="o">=</span> <span class="mi">0</span><span class="p">)</span>
    
    <span class="n">region_mask</span> <span class="o">=</span> <span class="p">(</span>
        <span class="p">(</span><span class="n">lat_all</span> <span class="o">&gt;=</span> <span class="n">lat_bounds</span><span class="p">[</span><span class="mi">0</span><span class="p">])</span> <span class="o">&amp;</span> <span class="p">(</span><span class="n">lat_all</span> <span class="o">&lt;=</span> <span class="n">lat_bounds</span><span class="p">[</span><span class="mi">1</span><span class="p">])</span> <span class="o">&amp;</span>
        <span class="p">(</span><span class="n">lon_all</span> <span class="o">&gt;=</span> <span class="n">lon_bounds</span><span class="p">[</span><span class="mi">0</span><span class="p">])</span> <span class="o">&amp;</span> <span class="p">(</span><span class="n">lon_all</span> <span class="o">&lt;=</span> <span class="n">lon_bounds</span><span class="p">[</span><span class="mi">1</span><span class="p">])</span>
    <span class="p">)</span>
    <span class="n">valid_ncol</span> <span class="o">=</span> <span class="n">np</span><span class="o">.</span><span class="n">where</span><span class="p">(</span><span class="n">region_mask</span><span class="o">.</span><span class="n">compute</span><span class="p">()</span><span class="o">.</span><span class="n">values</span><span class="p">)[</span><span class="mi">0</span><span class="p">]</span>
    
    <span class="n">lat_region</span> <span class="o">=</span> <span class="n">lat_all</span><span class="o">.</span><span class="n">isel</span><span class="p">(</span><span class="n">ncol</span> <span class="o">=</span> <span class="n">valid_ncol</span><span class="p">)</span><span class="o">.</span><span class="n">values</span>
    <span class="n">lon_region</span> <span class="o">=</span> <span class="n">lon_all</span><span class="o">.</span><span class="n">isel</span><span class="p">(</span><span class="n">ncol</span> <span class="o">=</span> <span class="n">valid_ncol</span><span class="p">)</span><span class="o">.</span><span class="n">values</span>
    <span class="n">points_region</span> <span class="o">=</span> <span class="n">np</span><span class="o">.</span><span class="n">column_stack</span><span class="p">((</span><span class="n">lon_region</span><span class="p">,</span> <span class="n">lat_region</span><span class="p">))</span>

    <span class="c1">#Create regular 2D grid</span>
    <span class="n">lon_grid</span> <span class="o">=</span> <span class="n">np</span><span class="o">.</span><span class="n">linspace</span><span class="p">(</span><span class="n">lon_bounds</span><span class="p">[</span><span class="mi">0</span><span class="p">],</span> <span class="n">lon_bounds</span><span class="p">[</span><span class="mi">1</span><span class="p">],</span> <span class="n">grid_res</span><span class="p">)</span>
    <span class="n">lat_grid</span> <span class="o">=</span> <span class="n">np</span><span class="o">.</span><span class="n">linspace</span><span class="p">(</span><span class="n">lat_bounds</span><span class="p">[</span><span class="mi">0</span><span class="p">],</span> <span class="n">lat_bounds</span><span class="p">[</span><span class="mi">1</span><span class="p">],</span> <span class="n">grid_res</span><span class="p">)</span>
    <span class="n">lon2d</span><span class="p">,</span> <span class="n">lat2d</span> <span class="o">=</span> <span class="n">np</span><span class="o">.</span><span class="n">meshgrid</span><span class="p">(</span><span class="n">lon_grid</span><span class="p">,</span> <span class="n">lat_grid</span><span class="p">)</span>

    <span class="c1">#Loop over months</span>
    <span class="n">monthly_grids</span> <span class="o">=</span> <span class="p">[]</span>

    <span class="k">for</span> <span class="n">m</span> <span class="ow">in</span> <span class="n">np</span><span class="o">.</span><span class="n">unique</span><span class="p">(</span><span class="n">z3</span><span class="p">[</span><span class="s1">'time.month'</span><span class="p">]</span><span class="o">.</span><span class="n">values</span><span class="p">):</span>
        <span class="n">t0_month</span> <span class="o">=</span> <span class="n">time</span><span class="o">.</span><span class="n">time</span><span class="p">()</span>

        <span class="c1">#Extract all times of this month</span>
        <span class="n">z_month</span> <span class="o">=</span> <span class="n">z3</span><span class="o">.</span><span class="n">sel</span><span class="p">(</span><span class="n">time</span> <span class="o">=</span> <span class="n">z3</span><span class="o">.</span><span class="n">time</span><span class="o">.</span><span class="n">dt</span><span class="o">.</span><span class="n">month</span> <span class="o">==</span> <span class="n">m</span><span class="p">)</span>

        <span class="c1">#Prepare array for this month</span>
        <span class="n">grid_accum</span> <span class="o">=</span> <span class="n">np</span><span class="o">.</span><span class="n">full</span><span class="p">((</span><span class="n">lat_grid</span><span class="o">.</span><span class="n">size</span><span class="p">,</span> <span class="n">lon_grid</span><span class="o">.</span><span class="n">size</span><span class="p">),</span> <span class="n">np</span><span class="o">.</span><span class="n">nan</span><span class="p">,</span> <span class="n">dtype</span> <span class="o">=</span> <span class="nb">float</span><span class="p">)</span>

        <span class="c1">#Chunk over ncol</span>
        <span class="n">N</span> <span class="o">=</span> <span class="nb">len</span><span class="p">(</span><span class="n">valid_ncol</span><span class="p">)</span>
        <span class="k">for</span> <span class="n">c0</span> <span class="ow">in</span> <span class="nb">range</span><span class="p">(</span><span class="mi">0</span><span class="p">,</span> <span class="n">N</span><span class="p">,</span> <span class="n">ncol_chunk</span><span class="p">):</span>
            <span class="n">c1</span> <span class="o">=</span> <span class="nb">min</span><span class="p">(</span><span class="n">c0</span> <span class="o">+</span> <span class="n">ncol_chunk</span><span class="p">,</span> <span class="n">N</span><span class="p">)</span>
            <span class="n">vals_chunk</span> <span class="o">=</span> <span class="n">z_month</span><span class="o">.</span><span class="n">isel</span><span class="p">(</span><span class="n">ncol</span> <span class="o">=</span> <span class="nb">slice</span><span class="p">(</span><span class="n">c0</span><span class="p">,</span> <span class="n">c1</span><span class="p">))</span><span class="o">.</span><span class="n">mean</span><span class="p">(</span><span class="s1">'time'</span><span class="p">)</span><span class="o">.</span><span class="n">values</span>
            <span class="n">pts_chunk</span> <span class="o">=</span> <span class="n">points_region</span><span class="p">[</span><span class="n">c0</span><span class="p">:</span><span class="n">c1</span><span class="p">]</span>

            <span class="c1">#Interpolate chunk (linear)</span>
            <span class="n">grid_chunk</span> <span class="o">=</span> <span class="n">griddata</span><span class="p">(</span><span class="n">pts_chunk</span><span class="p">,</span> <span class="n">vals_chunk</span><span class="p">,</span> <span class="p">(</span><span class="n">lon2d</span><span class="p">,</span> <span class="n">lat2d</span><span class="p">),</span> <span class="n">method</span> <span class="o">=</span> <span class="s1">'linear'</span><span class="p">)</span>

            <span class="c1">#Fill in only empty points</span>
            <span class="n">mask_empty</span> <span class="o">=</span> <span class="n">np</span><span class="o">.</span><span class="n">isnan</span><span class="p">(</span><span class="n">grid_accum</span><span class="p">)</span>
            <span class="n">grid_accum</span><span class="p">[</span><span class="n">mask_empty</span><span class="p">]</span> <span class="o">=</span> <span class="n">grid_chunk</span><span class="p">[</span><span class="n">mask_empty</span><span class="p">]</span>

        <span class="c1">#Fill small gaps with nearest</span>
        <span class="n">mask_nan</span> <span class="o">=</span> <span class="n">np</span><span class="o">.</span><span class="n">isnan</span><span class="p">(</span><span class="n">grid_accum</span><span class="p">)</span>
        <span class="k">if</span> <span class="n">np</span><span class="o">.</span><span class="n">any</span><span class="p">(</span><span class="n">mask_nan</span><span class="p">):</span>
            <span class="n">grid_nn</span> <span class="o">=</span> <span class="n">griddata</span><span class="p">(</span><span class="n">points_region</span><span class="p">,</span> <span class="n">z_month</span><span class="o">.</span><span class="n">mean</span><span class="p">(</span><span class="s1">'time'</span><span class="p">)</span><span class="o">.</span><span class="n">values</span><span class="p">,</span> <span class="p">(</span><span class="n">lon2d</span><span class="p">,</span> <span class="n">lat2d</span><span class="p">),</span> <span class="n">method</span> <span class="o">=</span> <span class="s1">'nearest'</span><span class="p">)</span>
            <span class="n">grid_accum</span><span class="p">[</span><span class="n">mask_nan</span><span class="p">]</span> <span class="o">=</span> <span class="n">grid_nn</span><span class="p">[</span><span class="n">mask_nan</span><span class="p">]</span>

        <span class="c1">#Smooth twice</span>
        <span class="n">grid_accum</span> <span class="o">=</span> <span class="n">smooth_nanaware</span><span class="p">(</span><span class="n">grid_accum</span><span class="p">,</span> <span class="n">sigma</span> <span class="o">=</span> <span class="n">smooth_sigma</span><span class="p">)</span>
        <span class="n">grid_accum</span> <span class="o">=</span> <span class="n">smooth_nanaware</span><span class="p">(</span><span class="n">grid_accum</span><span class="p">,</span> <span class="n">sigma</span> <span class="o">=</span> <span class="n">smooth_sigma</span><span class="p">)</span>

        <span class="n">monthly_grids</span><span class="o">.</span><span class="n">append</span><span class="p">(</span><span class="n">grid_accum</span><span class="p">)</span>

    <span class="c1">#Average over months</span>
    <span class="n">mean_grid</span> <span class="o">=</span> <span class="n">np</span><span class="o">.</span><span class="n">nanmean</span><span class="p">(</span><span class="n">np</span><span class="o">.</span><span class="n">stack</span><span class="p">(</span><span class="n">monthly_grids</span><span class="p">,</span> <span class="n">axis</span> <span class="o">=</span> <span class="mi">0</span><span class="p">),</span> <span class="n">axis</span> <span class="o">=</span> <span class="mi">0</span><span class="p">)</span>

    <span class="c1">#Return as DataArray</span>
    <span class="n">da_out</span> <span class="o">=</span> <span class="n">xr</span><span class="o">.</span><span class="n">DataArray</span><span class="p">(</span>
        <span class="n">mean_grid</span><span class="p">,</span>
        <span class="n">dims</span> <span class="o">=</span> <span class="p">(</span><span class="s1">'lat'</span><span class="p">,</span> <span class="s1">'lon'</span><span class="p">),</span>
        <span class="n">coords</span> <span class="o">=</span> <span class="p">{</span><span class="s1">'lat'</span><span class="p">:</span> <span class="n">lat_grid</span><span class="p">,</span> <span class="s1">'lon'</span><span class="p">:</span> <span class="n">lon_grid</span><span class="p">},</span>
        <span class="n">name</span> <span class="o">=</span> <span class="s1">'Z3'</span>
    <span class="p">)</span>

    <span class="k">return</span> <span class="n">da_out</span>

<span class="c1">#### RUN ####</span>

<span class="n">height_da</span> <span class="o">=</span> <span class="n">regrid_monthly_climatology_region</span><span class="p">(</span>
    <span class="n">zarr_path</span> <span class="o">=</span> <span class="s1">'Z3_pressure.zarr'</span><span class="p">,</span>
    <span class="n">ds_native</span> <span class="o">=</span> <span class="n">ds_combined</span><span class="p">,</span>
    <span class="n">lat_bounds</span> <span class="o">=</span> <span class="p">(</span><span class="mi">10</span><span class="p">,</span> <span class="mi">60</span><span class="p">),</span>
    <span class="n">lon_bounds</span> <span class="o">=</span> <span class="p">(</span><span class="mi">260</span><span class="p">,</span> <span class="mi">350</span><span class="p">),</span>
    <span class="n">p_level</span> <span class="o">=</span> <span class="mi">85000</span><span class="p">,</span>
    <span class="n">months</span> <span class="o">=</span> <span class="p">[</span><span class="mi">6</span><span class="p">,</span> <span class="mi">7</span><span class="p">,</span> <span class="mi">8</span><span class="p">,</span> <span class="mi">9</span><span class="p">,</span> <span class="mi">10</span><span class="p">,</span> <span class="mi">11</span><span class="p">],</span>
    <span class="n">grid_res</span> <span class="o">=</span> <span class="mi">200</span><span class="p">,</span>
    <span class="n">smooth_sigma</span> <span class="o">=</span> <span class="mi">4</span><span class="p">,</span>
    <span class="n">ncol_chunk</span> <span class="o">=</span> <span class="mi">50_000</span>
<span class="p">)</span>

<span class="n">height_da</span> <span class="o">=</span> <span class="n">height_da</span><span class="o">.</span><span class="n">load</span><span class="p">()</span>
