            <span class="n">z_interp</span> <span class="o">=</span> <span class="n">log_pressure_interp_chunk</span><span class="p">(</span><span class="n">z_chunk</span><span class="p">,</span> <span class="n">p_chunk</span><span class="p">,</span> <span class="n">p_target</span><span class="p">)</span>

