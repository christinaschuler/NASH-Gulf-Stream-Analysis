            <span class="n">z_chunk</span> <span class="o">=</span> <span class="n">ds</span><span class="p">[</span><span class="n">zvar</span><span class="p">]</span><span class="o">.</span><span class="n">isel</span><span class="p">(</span><span class="n">time</span> <span class="o">=</span> <span class="nb">slice</span><span class="p">(</span><span class="n">t0</span><span class="p">,</span> <span class="n">t1</span><span class="p">),</span> <span class="n">ncol</span> <span class="o">=</span> <span class="nb">slice</span><span class="p">(</span><span class="n">c0</span><span class="p">,</span> <span class="n">c1</span><span class="p">))</span><span class="o">.</span><span class="n">values</span>
            <span class="n">PS_chunk</span> <span class="o">=</span> <span class="n">ds</span><span class="p">[</span><span class="s1">'PS'</span><span class="p">]</span><span class="o">.</span><span class="n">isel</span><span class="p">(</span><span class="n">time</span> <span class="o">=</span> <span class="nb">slice</span><span class="p">(</span><span class="n">t0</span><span class="p">,</span> <span class="n">t1</span><span class="p">),</span> <span class="n">ncol</span> <span class="o">=</span> <span class="nb">slice</span><span class="p">(</span><span class="n">c0</span><span class="p">,</span> <span class="n">c1</span><span class="p">))</span><span class="o">.</span><span class="n">values</span>
            <span class="n">P0_chunk</span> <span class="o">=</span> <span class="n">P0_all</span><span class="p">[</span><span class="n">t0</span><span class="p">:</span><span class="n">t1</span><span class="p">]</span>

