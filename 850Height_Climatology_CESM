<div class="cm-editor cm-s-jupyter">
<div class="highlight hl-ipython3"><pre><span></span><span class="c1">#Start Dask client</span>
<span class="n">client</span> <span class="o">=</span> <span class="n">Client</span><span class="p">(</span><span class="n">n_workers</span> <span class="o">=</span> <span class="mi">4</span><span class="p">,</span> <span class="n">threads_per_worker</span> <span class="o">=</span> <span class="mi">1</span><span class="p">,</span> <span class="n">memory_limit</span> <span class="o">=</span> <span class="s1">'16GB'</span><span class="p">)</span>
<span class="nb">print</span><span class="p">(</span><span class="sa">f</span><span class="s2">"Dask client started: </span><span class="si">{</span><span class="n">client</span><span class="o">.</span><span class="n">dashboard_link</span><span class="si">}</span><span class="s2">"</span><span class="p">)</span>

<span class="c1">#Hybrid to pressure coordinates (per chunk)</span>
<span class="k">def</span><span class="w"> </span><span class="nf">hybrid_to_pressure_chunk</span><span class="p">(</span><span class="n">hyam</span><span class="p">,</span> <span class="n">hybm</span><span class="p">,</span> <span class="n">PS</span><span class="p">,</span> <span class="n">P0</span><span class="p">):</span>
<span class="w">    </span><span class="sd">"""</span>
<span class="sd">    hyam, hybm: (lev,)</span>
<span class="sd">    PS: (time_chunk, ncol_chunk)</span>
<span class="sd">    P0: (time_chunk,)</span>
<span class="sd">    returns p: (time_chunk, lev, ncol_chunk)</span>
<span class="sd">    """</span>
    <span class="k">return</span> <span class="p">(</span>
        <span class="n">hyam</span><span class="p">[</span><span class="kc">None</span><span class="p">,</span> <span class="p">:,</span> <span class="kc">None</span><span class="p">]</span> <span class="o">*</span> <span class="n">P0</span><span class="p">[:,</span> <span class="kc">None</span><span class="p">,</span> <span class="kc">None</span><span class="p">]</span> <span class="o">+</span>
        <span class="n">hybm</span><span class="p">[</span><span class="kc">None</span><span class="p">,</span> <span class="p">:,</span> <span class="kc">None</span><span class="p">]</span> <span class="o">*</span> <span class="n">PS</span><span class="p">[:,</span> <span class="kc">None</span><span class="p">,</span> <span class="p">:]</span>
    <span class="p">)</span>

<span class="c1">#Log-pressure interpolation</span>
<span class="k">def</span><span class="w"> </span><span class="nf">log_pressure_interp_chunk</span><span class="p">(</span><span class="n">z</span><span class="p">,</span> <span class="n">p</span><span class="p">,</span> <span class="n">p_target</span><span class="p">):</span>
    <span class="n">Nt</span><span class="p">,</span> <span class="n">Nlev</span><span class="p">,</span> <span class="n">Ncol</span> <span class="o">=</span> <span class="n">z</span><span class="o">.</span><span class="n">shape</span>
    <span class="n">out</span> <span class="o">=</span> <span class="n">np</span><span class="o">.</span><span class="n">empty</span><span class="p">((</span><span class="n">Nt</span><span class="p">,</span> <span class="nb">len</span><span class="p">(</span><span class="n">p_target</span><span class="p">),</span> <span class="n">Ncol</span><span class="p">),</span> <span class="n">dtype</span> <span class="o">=</span> <span class="n">z</span><span class="o">.</span><span class="n">dtype</span><span class="p">)</span>

    <span class="n">log_pt</span> <span class="o">=</span> <span class="n">np</span><span class="o">.</span><span class="n">log</span><span class="p">(</span><span class="n">p_target</span><span class="p">)</span>

    <span class="k">for</span> <span class="n">t</span> <span class="ow">in</span> <span class="nb">range</span><span class="p">(</span><span class="n">Nt</span><span class="p">):</span>
        <span class="k">for</span> <span class="n">c</span> <span class="ow">in</span> <span class="nb">range</span><span class="p">(</span><span class="n">Ncol</span><span class="p">):</span>
            <span class="n">out</span><span class="p">[</span><span class="n">t</span><span class="p">,</span> <span class="p">:,</span> <span class="n">c</span><span class="p">]</span> <span class="o">=</span> <span class="n">np</span><span class="o">.</span><span class="n">interp</span><span class="p">(</span>
                <span class="n">log_pt</span><span class="p">,</span>
                <span class="n">np</span><span class="o">.</span><span class="n">log</span><span class="p">(</span><span class="n">p</span><span class="p">[</span><span class="n">t</span><span class="p">,</span> <span class="p">:,</span> <span class="n">c</span><span class="p">]),</span>
                <span class="n">z</span><span class="p">[</span><span class="n">t</span><span class="p">,</span> <span class="p">:,</span> <span class="n">c</span><span class="p">]</span>
            <span class="p">)</span>
    <span class="k">return</span> <span class="n">out</span>

<span class="c1">#Mask-first and interpolate</span>
<span class="k">def</span><span class="w"> </span><span class="nf">interpolate_to_pressure_masked</span><span class="p">(</span>
    <span class="n">ds</span><span class="p">,</span>
    <span class="n">p_target</span><span class="p">,</span>
    <span class="n">zvar</span> <span class="o">=</span> <span class="s1">'Z3'</span><span class="p">,</span>
    <span class="n">zarr_path</span> <span class="o">=</span> <span class="s1">'Z3_pressure.zarr'</span><span class="p">,</span>
    <span class="n">time_chunk</span> <span class="o">=</span> <span class="mi">6</span><span class="p">,</span>
    <span class="n">ncol_chunk</span> <span class="o">=</span> <span class="mi">100_000</span><span class="p">,</span>
    <span class="n">lat_bounds</span> <span class="o">=</span> <span class="p">(</span><span class="mi">10</span><span class="p">,</span> <span class="mi">60</span><span class="p">),</span>
    <span class="n">lon_bounds</span> <span class="o">=</span> <span class="p">(</span><span class="mi">260</span><span class="p">,</span> <span class="mi">350</span><span class="p">)</span>
<span class="p">):</span>
    <span class="n">t0_all</span> <span class="o">=</span> <span class="n">time</span><span class="o">.</span><span class="n">time</span><span class="p">()</span>

    <span class="c1">#Spatial mask</span>
    <span class="nb">print</span><span class="p">(</span><span class="s2">"Applying spatial mask..."</span><span class="p">)</span>

    <span class="n">lat</span> <span class="o">=</span> <span class="n">ds</span><span class="p">[</span><span class="s1">'lat'</span><span class="p">]</span><span class="o">.</span><span class="n">isel</span><span class="p">(</span><span class="n">time</span> <span class="o">=</span> <span class="mi">0</span><span class="p">)</span>
    <span class="n">lon</span> <span class="o">=</span> <span class="n">ds</span><span class="p">[</span><span class="s1">'lon'</span><span class="p">]</span><span class="o">.</span><span class="n">isel</span><span class="p">(</span><span class="n">time</span> <span class="o">=</span> <span class="mi">0</span><span class="p">)</span>

    <span class="n">region_mask</span> <span class="o">=</span> <span class="p">(</span>
        <span class="p">(</span><span class="n">lat</span> <span class="o">&gt;=</span> <span class="n">lat_bounds</span><span class="p">[</span><span class="mi">0</span><span class="p">])</span> <span class="o">&amp;</span> <span class="p">(</span><span class="n">lat</span> <span class="o">&lt;=</span> <span class="n">lat_bounds</span><span class="p">[</span><span class="mi">1</span><span class="p">])</span> <span class="o">&amp;</span>
        <span class="p">(</span><span class="n">lon</span> <span class="o">&gt;=</span> <span class="n">lon_bounds</span><span class="p">[</span><span class="mi">0</span><span class="p">])</span> <span class="o">&amp;</span> <span class="p">(</span><span class="n">lon</span> <span class="o">&lt;=</span> <span class="n">lon_bounds</span><span class="p">[</span><span class="mi">1</span><span class="p">])</span>
    <span class="p">)</span>

    <span class="n">valid_ncol</span> <span class="o">=</span> <span class="n">region_mask</span><span class="o">.</span><span class="n">compute</span><span class="p">()</span><span class="o">.</span><span class="n">values</span>
    <span class="nb">print</span><span class="p">(</span><span class="sa">f</span><span class="s2">"Keeping </span><span class="si">{</span><span class="n">valid_ncol</span><span class="o">.</span><span class="n">sum</span><span class="p">()</span><span class="si">}</span><span class="s2"> of </span><span class="si">{</span><span class="n">valid_ncol</span><span class="o">.</span><span class="n">size</span><span class="si">}</span><span class="s2"> columns"</span><span class="p">)</span>

    <span class="n">ds</span> <span class="o">=</span> <span class="n">ds</span><span class="o">.</span><span class="n">isel</span><span class="p">(</span><span class="n">ncol</span> <span class="o">=</span> <span class="n">valid_ncol</span><span class="p">)</span>

    <span class="c1">#Extract hybrid coefficients (FORCED 1D)</span>
    <span class="n">hyam</span> <span class="o">=</span> <span class="n">ds</span><span class="p">[</span><span class="s1">'hyam'</span><span class="p">]</span><span class="o">.</span><span class="n">isel</span><span class="p">(</span><span class="n">time</span> <span class="o">=</span> <span class="mi">0</span><span class="p">)</span><span class="o">.</span><span class="n">values</span> <span class="k">if</span> <span class="s1">'time'</span> <span class="ow">in</span> <span class="n">ds</span><span class="p">[</span><span class="s1">'hyam'</span><span class="p">]</span><span class="o">.</span><span class="n">dims</span> <span class="k">else</span> <span class="n">ds</span><span class="p">[</span><span class="s1">'hyam'</span><span class="p">]</span><span class="o">.</span><span class="n">values</span>
